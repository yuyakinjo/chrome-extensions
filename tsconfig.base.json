{
  // Chrome 拡張機能に共通のコンパイラ設定。各拡張の tsconfig.json から extends する。
  // types / rootDir / outDir / include は拡張ごとに違うので、ここには置かない。
  "compilerOptions": {
    // Chrome 111+ 前提なので、ダウンレベルせずそのまま出す
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    // ブラウザが読む ESM をそのまま出す。import の指定子は書いたとおりに残す
    // （'./lib/settings.js' と書けば .ts を解決しつつ .js のまま出力される）
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,

    "sourceMap": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "skipLibCheck": true
  }
}
